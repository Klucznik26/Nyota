{
  "name": "nyota-language-support",
  "displayName": "Nyota Language Support",
  "description": "Syntax highlighting and editor configuration for Nyota (.nyo).",
  "version": "0.1.0",
  "publisher": "klucznik26",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Klucznik26/Nyota.git"
  },
  "contributes": {
    "languages": [
      {
        "id": "nyota",
        "aliases": [
          "Nyota",
          "nyota"
        ],
        "extensions": [
          ".nyo"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "nyota",
        "scopeName": "source.nyota",
        "path": "./syntaxes/nyota.tmLanguage.json"
      }
    ]
  }
}
