# Oczekiwane: zawiera ADVANCED_UI_OK
BEGIN
WIN glowne, ROOT, [1100, 820]

TBOX login, glowne, [260, 34], [25, 25], TEXT="Nyota", PLACEHOLDER="Wpisz nazwe", MAXLEN=32, BORDER=TRUE
SPINBOX temp_limit, glowne, [180, 34], [310, 25], MIN=-20, MAX=120, VALUE=70, STEP=5, BORDER=TRUE

LISTVIEW disks, glowne, [250, 180], [25, 90], ITEMS=["C:", "D:", "E:", "Backup"], SELECTED=1, ROWHEIGHT=34, BORDER=TRUE
TREEVIEW tree, glowne, [300, 220], [300, 90], ITEMS=["System", "System/CPU", "System/GPU", "Storage", "Storage/SSD", "Storage/HDD"], SELECTED=0, ROWHEIGHT=32, INDENT=22, SHOWLINES=TRUE, BORDER=TRUE

SPLITTER split, glowne, [520, 36], [25, 300], ORIENTATION=VERTICAL, MIN=0, MAX=1000, VALUE=450, STEP=10, THICK=8, CSEP=SAPPHIRE

SCALE linear, glowne, [520, 100], [25, 360], MIN=-60, MAX=0, VALUE=-20, STEP=5, ORIENTATION=HORIZONTAL
SCALE linear.CONFIG:
    SHAPE = LINE
    TRACKWIDTH = 7
    TRACKSTYLE = SEGMENT
    TRACKGAP = 4
    TRACKFILL = GRAD(LINEAR, HORIZONTAL, 3, [SAPPHIRE, PURPLE, RUBY])
    TRACKGLOW = SAPPHIRE
    TRACKBLUR = 3
    THUMB = DIAMOND
    THUMBSIZE = 20
    THUMBFILL = WHITE
    THUMBGLOW = SAPPHIRE
    THUMBBLUR = 5
    MAJORSTEP = 10
    MINORSTEP = 5
    CTICK = WHITE
    CMINORTICK = GRAY
    SHOWLABELS = TRUE
    LABELSTEP = 10

SCALE rotor, glowne, [260, 260], [630, 40], MIN=0, MAX=360, VALUE=359, STEP=1
SCALE rotor.CONFIG:
    SHAPE = CIRCLE
    RADIUS = 95
    WRAP = TRUE
    STARTANGLE = 0
    TRACKWIDTH = 8
    TRACKSTYLE = SOLID
    TRACKFILL = GRAD(LINEAR, VERTICAL, 3, [SAPPHIRE, PURPLE, RUBY])
    TRACKGLOW = PURPLE
    TRACKBLUR = 4
    THUMB = TRIANGLE
    THUMBSIZE = 22
    THUMBROTATE = TRUE
    THUMBALIGN = RADIAL
    THUMBFILL = WHITE
    THUMBGLOW = SAPPHIRE
    THUMBBLUR = 6

CLOCK hw, glowne, [360, 360], [650, 380], NEEDLES=3, MIN=0, MAX=110
CLOCK hw.CONFIG:
    SHAPE = ARC
    RADIUS = 145
    STARTANGLE = 210
    ENDANGLE = 510
    VALUES = [58, 72, 1400]
    NEEDLEMINS = [0, 0, 0]
    NEEDLEMAXS = [110, 110, 3000]
    NEEDLECOLORS = [SAPPHIRE, RUBY, GOLD]
    NEEDLESHAPES = ["LINE", "TRIANGLE", "ARROW"]
    NEEDLEWIDTHS = [3, 5, 3]
    NEEDLELENS = [115, 105, 92]
    NEEDLEBLURS = [2, 4, 1]
    MAJORSTEP = 10
    MINORSTEP = 2
    CTICK = WHITE
    CMINORTICK = GRAY
    TICKLEN = 14
    MINORTICKLEN = 7
    TICKBLUR = 1
    SHOWLABELS = TRUE
    LABELSTEP = 20
    BG = GRAD(RADIAL, 3, [BLACK, DARKGRAY, BLACK])
    DIALBLUR = 2
    BORDER = TRUE
    CBORDER = GRAY
    BWIDTH = 2
    CENTERDOT = TRUE
    CCENTER = WHITE
    CENTERSIZE = 12
    CENTERBLUR = 2
    TEXT = "Hardware"
    UNIT = "C"
    SHOWVALUE = TRUE
    ZONES = [[0, 70, EMERALD], [70, 90, GOLD], [90, 110, RUBY]]

IF TBOX_TEXT(login) <> "Nyota":
    PRINT "TBOX_TEXT_FAIL"
VAR tb := TBOX_SET(login, "AyoOS")
IF NOT tb:
    PRINT "TBOX_SET_FAIL"
IF TBOX_TEXT(login) <> "AyoOS":
    PRINT "TBOX_SET_TEXT_FAIL"

VAR sp := SPINBOX_SET(temp_limit, 85)
IF NOT sp:
    PRINT "SPINBOX_SET_FAIL"
IF SPINBOX_VALUE(temp_limit) <> 85:
    PRINT "SPINBOX_VALUE_FAIL"

VAR ls := LISTVIEW_SET(disks, 2)
IF NOT ls:
    PRINT "LISTVIEW_SET_FAIL"
IF LISTVIEW_INDEX(disks) <> 2:
    PRINT "LISTVIEW_INDEX_FAIL"
IF LISTVIEW_VALUE(disks) <> "E:":
    PRINT "LISTVIEW_VALUE_FAIL"

VAR ts := TREEVIEW_SET(tree, 4)
IF NOT ts:
    PRINT "TREEVIEW_SET_FAIL"
IF TREEVIEW_VALUE(tree) <> "Storage/SSD":
    PRINT "TREEVIEW_VALUE_FAIL"

VAR spl := SPLITTER_SET(split, 600)
IF NOT spl:
    PRINT "SPLITTER_SET_FAIL"
IF SPLITTER_VALUE(split) <> 600:
    PRINT "SPLITTER_VALUE_FAIL"

VAR sc := SCALE_SET(linear, -10)
IF NOT sc:
    PRINT "SCALE_SET_FAIL"
IF SCALE_VALUE(linear) <> -10:
    PRINT "SCALE_VALUE_FAIL"

VAR wr := SCALE_SET(rotor, 361)
IF NOT wr:
    PRINT "SCALE_WRAP_SET_FAIL"
IF SCALE_VALUE(rotor) <> 1:
    PRINT "SCALE_WRAP_VALUE_FAIL"

VAR cn := CLOCK_NEEDLE(hw, 1, 75)
IF NOT cn:
    PRINT "CLOCK_NEEDLE_FAIL"
IF CLOCK_VALUE(hw, 1) <> 75:
    PRINT "CLOCK_VALUE_FAIL"

VAR cs := CLOCK_SET(hw, [61, 76, 1500])
IF NOT cs:
    PRINT "CLOCK_SET_FAIL"
VAR cv := CLOCK_VALUES(hw)
IF LEN(cv) <> 3:
    PRINT "CLOCK_VALUES_FAIL"

PRINT "ADVANCED_UI_OK"
END
