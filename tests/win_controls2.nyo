# Oczekiwane: zawiera UI2_OK
BEGIN
WIN glowne, ROOT, [640, 480]
WIN glowne.CONFIG:
    BG = DARKGRAY
    SHADOW = RD
    CSHADOW = BLACK
    SDEPTH = 2

PANEL karta, glowne, [580, 400], [20, 20], BG=GRAY, BORDER=TRUE, CBORDER=LIGHTGRAY, BWIDTH=1, RADIUS=10

BUTTON ok, karta, [120, 36], [20, 20], TEXT="OK", RADIUS=8
BUTTON nieaktywny, karta, [150, 36], [160, 20], TEXT="Disabled", ENABLED=FALSE

DAREA drop, karta, [160, 80], [20, 70], SHAPE=RECT, BG=DARKGRAY, BORDER=TRUE, CBORDER=GRAY, BWIDTH=1, RADIUS=8

CBOX zgoda, karta, [220, 20], 1, CHECKED=TRUE, BG=WHITE, BORDER=TRUE, CBORDER=GRAY, BWIDTH=1, CCHECK=EMERALD, CSYMBOL=X

RADIO r1, karta, [220, 60], 1, RGROUP=tryb, CHECKED=TRUE, BG=WHITE, BORDER=TRUE, CBORDER=GRAY, BWIDTH=1, CCHECK=SAPPHIRE
RADIO r2, karta, [260, 60], 1, RGROUP=tryb, CHECKED=FALSE, BG=WHITE, BORDER=TRUE, CBORDER=GRAY, BWIDTH=1, CCHECK=SAPPHIRE

VAR tryby := ["Automatyczny", "Reczny", "Wylaczony"]
COMBO tryb, karta, [220, 32], [20, 180], ITEMS=tryby, SELECTED=1, BG=DARKGRAY, CTEXT=WHITE, BORDER=TRUE, CBORDER=GRAY, BWIDTH=1, CARROW=WHITE, BGDROP=BLACK, CDROP=LIGHTGRAY, BGSELECT=SAPPHIRE, CSELECT=WHITE, HOVER=ON, BGHOVER=DARKSAPPHIRE, CHOVER=WHITE, MAXVISIBLE=8, RADIUS=6

SEP s1, karta, [20, 230], 300, HORIZONTAL, EFFECT=INSET, CSEP=GRAY, THICK=2

TABS tabs, karta, [520, 130], [20, 250], SELECTED=0
TAB general, tabs, "General"
TAB general.CONFIG:
    TABBG = SAPPHIRE
    TABFONT = "SYSTEM"
    TABFSIZE = 14
    TABCTEXT = WHITE
    TABBOLD = TRUE
    TABBORDER = TRUE
    TABCBORDER = LIGHTGRAY
    TABBWIDTH = 1
    TABRADIUS = 6
    BG = DARKGRAY
    BORDER = TRUE
    CBORDER = GRAY
    BWIDTH = 1
    RADIUS = 8
    CLIP = TRUE

TAB driver, tabs, "Driver"
LABEL opis, general, [220, 24], [10, 10], TEXT="Zakladka dziala", CTEXT=WHITE

IF NOT CBOX_CHECKED(zgoda):
    PRINT "CBOX_FAIL"

VAR ustaw := RADIO_SET(r2, TRUE)
IF RADIO_CHECKED(r1):
    PRINT "RADIO_FAIL"

IF COMBO_INDEX(tryb) <> 1:
    PRINT "COMBO_FAIL"

PRINT "UI2_OK"
END
