# Oczekiwane: zawiera RANGE_UI_OK
BEGIN
WIN glowne, ROOT, [720, 420]

LABEL ls, glowne, [260, 24], [30, 30], TEXT="SBAR shapes", CTEXT=WHITE

SBAR scroll, glowne, [320, 28], [30, 65], MIN=0, MAX=100, VALUE=35, PAGE=20, STEP=5, ORIENTATION=HORIZONTAL, THUMB=PARALLELOGRAM, CTHUMB=SAPPHIRE, CTHUMBOVER=LIGHTSAPPHIRE, BG=DARKGRAY, BORDER=TRUE, CBORDER=GRAY, RADIUS=7

LABEL lp, glowne, [260, 24], [30, 125], TEXT="PBAR segmented", CTEXT=WHITE

PBAR progress, glowne, [500, 34], [30, 160], MIN=0, MAX=100, VALUE=65, SHAPE=CIRCLE, SEGMENTS=20, SPACING=5, CFILL=EMERALD, CEMPTY=DARKGRAY, BG=BLACK, BORDER=TRUE, CBORDER=GRAY, RADIUS=7

PBAR tri, glowne, [500, 36], [30, 215], MIN=0, MAX=100, VALUE=40, SHAPE=TRIANGLE, SEGMENTS=12, SPACING=4, CFILL=SAPPHIRE, CEMPTY=DARKGRAY

PBAR sq, glowne, [500, 34], [30, 270], MIN=0, MAX=100, VALUE=75, SHAPE=SQUARE, SEGMENTS=16, SPACING=4, CFILL=GOLD, CEMPTY=DARKGRAY

PBAR para, glowne, [500, 34], [30, 325], MIN=0, MAX=100, VALUE=55, SHAPE=PARALLELOGRAM, SEGMENTS=14, SPACING=3, CFILL=LIGHTSAPPHIRE, CEMPTY=DARKGRAY

IF SBAR_VALUE(scroll) <> 35:
    PRINT "SBAR_VALUE_FAIL"

VAR ss := SBAR_SET(scroll, 60)
IF NOT ss:
    PRINT "SBAR_SET_FAIL"

VAR ps := PBAR_SET(progress, 80)
IF NOT ps:
    PRINT "PBAR_SET_FAIL"

IF PBAR_VALUE(progress) <> 80:
    PRINT "PBAR_VALUE_FAIL"

PRINT "RANGE_UI_OK"
END
