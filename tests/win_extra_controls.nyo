# Oczekiwane: zawiera EXTRA_UI_OK
BEGIN
WIN glowne, ROOT, [760, 520]

TOOLBAR tools, glowne, [720, 44], [20, 15], BG=DARKGRAY, BORDER=TRUE, CBORDER=GRAY, BWIDTH=1, RADIUS=6
BUTTON start, tools, [90, 28], AUTO, TEXT="Start"
BUTTON stop, tools, [90, 28], AUTO, TEXT="Stop"

SLIDER volume, glowne, [360, 30], [30, 90], MIN=0, MAX=100, VALUE=35, STEP=5, ORIENTATION=HORIZONTAL, THUMB=CIRCLE, THUMBSIZE=24, CTHUMB=SAPPHIRE, CTHUMBOVER=LIGHTSAPPHIRE, BG=DARKGRAY, BORDER=TRUE, CBORDER=GRAY, RADIUS=7

EQBOX eq, glowne, [620, 270], [30, 145], BARS=8, VALUES=[15, 30, 55, 80, 100, 72, 44, 22], MIN=0, MAX=100, BARWIDTH=38, GAP=16, MINHEIGHT=0, MAXHEIGHT=190, BUILD=CIRCLE, SEGMENTGAP=3, ORIENTATION=VERTICAL, DIRECTION=UP, BG=GRAD(LINEAR, VERTICAL, 2, [BLACK, DARKBLUE]), BARBG=GRAD(LINEAR, VERTICAL, 2, [DARKGRAY, BLACK]), BARFILL=GRAD(LINEAR, VERTICAL, 4, [EMERALD, LIME, GOLD, RUBY]), GLOW=GRAD(LINEAR, VERTICAL, 2, [SAPPHIRE, TRANSPARENT]), BLUR=6, LABELS=["60", "120", "250", "500", "1K", "2K", "4K", "8K"], SHOWLABELS=TRUE, LABELPOS=BOTTOM, CTEXT=WHITE, FSIZE=11, BORDER=TRUE, CBORDER=GRAY, BWIDTH=1, RADIUS=9

STATBAR status, glowne, [720, 34], [20, 465], BG=DARKGRAY, BORDER=TRUE, CBORDER=GRAY, BWIDTH=1
LABEL ready, status, [180, 24], AUTO, TEXT="Ready", CTEXT=WHITE
LABEL value, status, [180, 24], AUTO, TEXT="EQBOX live", CTEXT=LIGHTGRAY

IF SLIDER_VALUE(volume) <> 35:
    PRINT "SLIDER_VALUE_FAIL"

VAR s := SLIDER_SET(volume, 70)
IF NOT s:
    PRINT "SLIDER_SET_FAIL"

IF SLIDER_VALUE(volume) <> 70:
    PRINT "SLIDER_SET_VALUE_FAIL"

VAR e := EQBOX_SET(eq, [20, 40, 60, 80, 95, 75, 50, 25])
IF NOT e:
    PRINT "EQBOX_SET_FAIL"

VAR b := EQBOX_BAR(eq, 3, 88)
IF NOT b:
    PRINT "EQBOX_BAR_FAIL"

PRINT "EXTRA_UI_OK"
END
