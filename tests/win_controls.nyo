# Oczekiwane: zawiera UICTRL_OK
BEGIN
WIN glowne, ROOT, [640, 480], CENTER, FALSE
PANEL karta, glowne, [300, 300], [20, 20], BG=GRAD(LINEAR, VERTICAL, 2, [DARKNAVY, BLACK]), BORDER=TRUE, CBORDER=GRAY, BWIDTH=2
LABEL tytul, karta, [260, 40], [20, 20], TEXT="Ustawienia", FSIZE=20, CTEXT=WHITE, BOLD=TRUE, BORDER=TRUE, CBORDER=SAPPHIRE, BWIDTH=1
BUTTON zapisz, karta, [160, 48], [20, 80], TEXT="Zapisz", BG=SAPPHIRE, CTEXT=WHITE
DAREA drop1, karta, [120, 120], [20, 150], TEXT="DROP", SHAPE=CIRCLE, BORDER=TRUE, CBORDER=EMERALD, BWIDTH=2, ACCEPT=FILES, MULTI=TRUE
DAREA drop2, karta, [120, 80], [160, 170], TEXT="DROP", SHAPE=ELLIPSE
LABEL tytul.CONFIG:
    FONT = "SYSTEM"
    ITALIC = FALSE
    UNDERLINE = FALSE
    HALIGN = CENTER
    VALIGN = MIDDLE
    WRAP = FALSE
PANEL karta.CONFIG:
    CLIP = TRUE
DAREA drop1.CONFIG:
    BGOVER = GRAD(LINEAR, HORIZONTAL, 2, [DARKSAPPHIRE, SAPPHIRE])
    CBORDEROVER = LIGHTSAPPHIRE
    BWIDTHOVER = 3
PRINT "UICTRL_OK"
END
